generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String          @id @default(cuid())
  email      String          @unique
  name       String?
  preference  UserPreference?
  briefings  DailyBriefing[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model UserPreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics        Json
  countries     Json
  companies     Json
  people        Json
  keywords      Json
  hiddenTopics  Json
  sourceIds     Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Category {
  id              String    @id @default(cuid())
  slug            String    @unique
  name            String
  description     String?
  isDefault       Boolean   @default(true)
  sortOrder       Int       @default(0)
  sources         Source[]
  articles        Article[]
  stories         Story[]   @relation("PrimaryCategory")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Source {
  id              String        @id @default(cuid())
  name            String
  url             String        @unique
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])
  language        String        @default("en")
  country         String        @default("US")
  enabled         Boolean       @default(true)
  credibility     Float         @default(0.75)
  metadata        Json
  lastFetchedAt   DateTime?
  lastSuccessAt   DateTime?
  lastError       String?
  failureCount    Int           @default(0)
  articles        Article[]
  storySources    StorySource[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([enabled])
  @@index([categoryId])
}

model Article {
  id              String        @id @default(cuid())
  title           String
  url             String
  canonicalUrl    String        @unique
  sourceId        String
  source          Source        @relation(fields: [sourceId], references: [id])
  author          String?
  publishedAt     DateTime?
  retrievedAt     DateTime      @default(now())
  description     String?
  imageUrl        String?
  content         String?
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])
  tags            Json
  fingerprint     String
  storyId         String?
  story           Story?        @relation(fields: [storyId], references: [id], onDelete: SetNull)
  storySources    StorySource[]
  articleTags     ArticleTag[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([publishedAt])
  @@index([categoryId, publishedAt])
  @@index([sourceId, publishedAt])
  @@index([fingerprint])
  @@index([storyId])
}

model Story {
  id               String        @id @default(cuid())
  headline         String
  summary          String?
  whyItMatters     String?
  keyFacts         Json
  whatHappensNext  String?
  confidence       String        @default("Reported")
  importanceScore  Float         @default(0)
  primaryCategoryId String
  primaryCategory  Category      @relation("PrimaryCategory", fields: [primaryCategoryId], references: [id])
  articles         Article[]
  storySources     StorySource[]
  relatedFrom      StoryRelation[] @relation("RelatedFrom")
  relatedTo        StoryRelation[] @relation("RelatedTo")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  lastUpdatedAt    DateTime      @default(now())

  @@index([lastUpdatedAt])
  @@index([primaryCategoryId, lastUpdatedAt])
  @@index([importanceScore])
}

model StorySource {
  id        String   @id @default(cuid())
  storyId   String
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  sourceId  String
  source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([storyId, articleId])
  @@index([sourceId])
}

model Tag {
  id          String        @id @default(cuid())
  name        String        @unique
  articleTags ArticleTag[]
}

model ArticleTag {
  articleId String
  tagId     String
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

model DailyBriefing {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime
  generatedAt DateTime @default(now())
  sections    Json
  storyIds    Json

  @@unique([userId, date])
  @@index([date])
}

model IngestionRun {
  id              String    @id @default(cuid())
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  status          String    @default("running")
  articlesFetched Int       @default(0)
  articlesUpserted Int      @default(0)
  storiesCreated  Int       @default(0)
  errors          Json
}

model StoryRelation {
  id          String @id @default(cuid())
  fromStoryId String
  toStoryId   String
  fromStory   Story  @relation("RelatedFrom", fields: [fromStoryId], references: [id], onDelete: Cascade)
  toStory     Story  @relation("RelatedTo", fields: [toStoryId], references: [id], onDelete: Cascade)

  @@unique([fromStoryId, toStoryId])
}
